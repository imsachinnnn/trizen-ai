# Django Core Configuration
DEBUG=True
SECRET_KEY=django-insecure-trizen-photo-sharing-platform-secret-key-2026
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL / Supabase)
# Set USE_POSTGRES=True to enable production PostgreSQL / Supabase DB
USE_POSTGRES=False
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_supabase_db_password
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432

# Cloudflare R2 Private Object Storage Configuration
# Set USE_R2_STORAGE=True to enable production Cloudflare R2 storage
USE_R2_STORAGE=False
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_ACCOUNT_ID=your_r2_account_id
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_REGION_NAME=auto
R2_PUBLIC_DOMAIN=
